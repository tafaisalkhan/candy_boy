# Godot 4 Engine caches
.godot/
*.tmp
*.import

# User Request Exclusions
# 1. No Assets
assets/
resources/
*.png
*.jpg
*.jpeg
*.svg
*.wav
*.mp3
*.ogg
*.fbx
*.obj
*.gltf
*.glb
*.ttf
*.otf

# 2. No Keys
*.keystore
*.jks
*.key
*.p12
*.pem

# 3. No JSON files
*.json

# Temporary flags & screenshots
*.flag
screenshot_*
*.log
*.cmd

# Internal State & Notes
STATE.md

# Large binary downloads in addons
addons/**/downloads/
addons/**/.gdignore
*.zip

# Android Build & Output
android/
build/
*.aab
*.apk

# Local-only AdMob production IDs & Keystore credentials
admob_secrets*
release_signing*
export_presets*
export_credentials*
key.properties
**/key.properties
keystore_credentials*

